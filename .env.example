# DeSaga cu Legume - environment variables (PLACEHOLDERS ONLY).
# Copy to `.env.local` and fill with real values. Never commit real secrets.
#
# Only the variables below are read by the application code. Each name is
# documented; values here are intentionally fake placeholders.

# --- Supabase (required) ---------------------------------------------------
# Public project URL and anon key are exposed to the browser ($env/static/public).
PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Service-role key - SERVER ONLY ($env/static/private). Full DB access; bypasses
# RLS. Never expose to the client, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Security tuning (optional; have safe defaults in code) ----------------
# Force HTTPS redirect / HSTS behavior in production. "true" | "false".
SECURITY_ENFORCE_HTTPS="false"
# (security_events retention moved to pg_cron: run_cleanup_security_events in
# supabase/migrations/20260710_07_pg_cron_cleanup.sql, default 90 days.)
# Trusted reverse proxy for the client IP header. One of: "vercel" (x-real-ip),
# "cloudflare" (cf-connecting-ip), or unset/"none" for the direct address only.
# Never trust a list of headers: cf-connecting-ip passes through Vercel
# unfiltered and can be spoofed by clients.
TRUSTED_PROXY="none"

# Server-side Supabase fetch timeout in milliseconds (default 8000). Prevents a
# hung Supabase call from blocking the function until the platform timeout.
SUPABASE_FETCH_TIMEOUT_MS="8000"

# --- Runtime ---------------------------------------------------------------
# Standard Node environment. "development" | "production".
NODE_ENV="development"
